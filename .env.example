# Enter your credentials below, then rename this file to .env in the repository root.
# KALSHI_API_KEY is the API Key ID, not your password or private-key contents.
KALSHI_API_KEY=replace-with-your-api-key-id
# Save your downloaded private key in the repository root with this filename.
KALSHI_PRIVATE_KEY_PATH=kalshi_private.key
# Starting-balance baseline in cents. Used for paper equity and live P/L tracking.
# 11500 means $115.00; 100000 means $1,000.00.
BTC15_STARTING_BALANCE_CENTS=11500
